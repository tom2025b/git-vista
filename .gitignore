# Rust build output
/target

# Trunk build output for the Leptos frontend
/crates/git-vista/dist

# Claude Code local settings (machine-specific permissions), including the
# transient `*.tmp.<pid>.<hash>` files it writes while updating them.
.claude/settings.local.json
.claude/settings.local.json.tmp.*

# Local Codex architecture review and continuation handoff
/codex-code-review.md
/codex-code-review.pdf
/codex-code-review-handoff.md
/codex-code-review-handoff.pdf

# Local session handoff / resume note (see `./dev resume`). Local working state,
# not repo history — the durable record is the WIP git commits `./dev wip` pushes.
/handoff.md
/handoff.pdf

# Personal GitHub issue staging list
/issues.md

# Agent-session instructions and running memory. These files are useful in a
# local checkout but are not product documentation or a durable project record.
# Existing copies are intentionally preserved in the worktree; remove them
# from the index separately if this repository is being cleaned up.
/CLAUDE.md
/AGENTS.md
/PROJECT_MEMORY.md
/PROJECT_STATUS.md
/docs/prompts/

# Per-repo journal note staging (rendered into ~/Documents/journals by the
# printpdf MCP server). Local record of sessions, not project history.
/.journal/

# Browser-automation scratch output from driving the app during verification:
# page snapshots, console dumps, and the screenshots taken alongside them.
/.playwright-mcp/
/*.png
/Test/

# The browser test suite (ci/browser) is tracked; everything it GENERATES is
# not. `.runtime.json` and `.storage.json` carry a live server's port and a real
# session cookie, so they are per-run secrets as well as noise.
/ci/browser/node_modules/
/ci/browser/test-results/
/ci/browser/playwright-report/
/ci/browser/.runtime.json
/ci/browser/.storage.json

# Rendered PDFs are TRACKED, and they all live in one place:
# docs/superpowers/pdf/. Keeping them out of docs/adr/ stops a rendered twin
# sitting beside its source and being mistaken for the record — the `.md` is
# always the record; the PDF is the printable copy of it.
/docs/adr/*.pdf
/docs/superpowers/plans/*.pdf
/docs/superpowers/specs/*.pdf
/docs/superpowers/evidence/*.pdf
!/docs/superpowers/pdf/

# Local print/archive outputs generated from the documentation set
/ALL_DOCUMENTATION.md
/DOCUMENTATION_ASSESSMENT.md
/codex-m1-future-code-review.md

# Local design documents (md + pdf pairs) — session artifacts, not product docs
/design-docs/

# Live dual-account mailbox — session state, not project history.
# Both sessions read/write these at one absolute path; they must not travel through git.
.claude/parallel/

# gv-scrollcast (#325) render output — big PNGs and MP4s, never product.
# The tool's --out guard permits an in-repo path ONLY when git actually
# ignores it, so this entry is what makes the documented default (`./out`)
# usable at all. Removing it does not loosen anything; it makes the default
# stop working, loudly.
/out/

# PDF twins never sit beside their .md — the .md is the record (standing rule).
crates/**/README.pdf
/README.pdf
target-testbed-*/
/ci/browser/*.pdf

# Cold-build measurement report (ci/cold_build_measure.sh) — a machine-local
# observation, not repository history. The numbers that matter are transcribed
# into docs/PERFORMANCE_BUDGETS.md.
/cold-build-report.txt
