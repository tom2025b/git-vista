#!/usr/bin/env bash
# gv — build the git-vista frontend and start the server for a git repo.
#
# Serves the SPA + API on http://127.0.0.1:8080 by default. Use an SSH local port
# forward from the iPad, or opt into the unauthenticated legacy LAN mode with
# --lan. Run it from anywhere; it locates the git-vista repo from its own path and
# visualises whichever repo you point it at.
#
#   gv                  visualise the CURRENT directory's repo
#   gv ~/code/myproj    visualise another repo by path
#   gv --lan [path]     bind all interfaces for a trusted personal LAN
#   gv --stop           stop the running server
#   gv --token          reprint the one-time sign-in link for the running server
#   gv --seed [path]    mark a repo as a TEST repo: record its current branches,
#                       HEAD and objects as the reset point the app's
#                       "Reset Test Repo" button restores (rerun to re-record)
#
# Sign-in (M1.04): the server needs a one-time session before it will answer the
# API. gv prints a setup link — http://localhost:8080/#s=<token> — after it starts;
# open it once in the browser to sign that browser in. The token rides in the URL
# *fragment* (never sent to the server, never logged); the server writes it 0600 to
# $XDG_STATE_HOME/git-vista/bootstrap.token, which is the only thing gv reads to
# build the link. It's single-use: opening the link rotates in a fresh token, so a
# second device can `gv --token` for a new link. A server restart mints a new one.
#
# The server runs DETACHED (its own session, logging to a file), so closing the
# terminal or losing the SSH session that launched gv no longer kills it — which
# used to surface on the iPad, minutes later, as "Type error. Load failed" on
# the next write. Ctrl-C is no longer how you stop it: use `gv --stop`, or just
# run gv again (a restart always replaces the old server).
#
# While actively developing, gv ALWAYS does a CLEAN rebuild of the wasm frontend
# (trunk clean + trunk build) before starting the server, so a stale/cached bundle
# can never be served. (We can reintroduce an incremental/--no-build fast path when
# we're ready to ship to other people.)
set -euo pipefail

# Where you ran gv from (the repo to visualise defaults to this).
START_DIR="$PWD"

# The detached server's log — the server's banner (with the firewall tips) and
# everything it prints land here. Kept under XDG state, out of any repo.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/git-vista"
LOG="$LOG_DIR/server.log"
# The one-time session bootstrap token (M1.04), written 0600 by the server. This
# path must match the server's `state::bootstrap_token_path()`. Only gv reads it.
TOKEN_FILE="$LOG_DIR/bootstrap.token"

# Print the browser sign-in link for `host` (default localhost) by folding the
# current bootstrap token into a URL fragment. The fragment never reaches the
# server, so the token stays out of access logs. Silent (returns 1) if the token
# file isn't there yet — the caller decides whether that's worth a warning.
print_setup_url() {
  local host="${1:-localhost:8080}"
  local token
  token="$(tr -d '[:space:]' <"$TOKEN_FILE" 2>/dev/null)" || return 1
  [[ -n "$token" ]] || return 1
  echo "gv: sign in on the iPad/browser by opening this one-time link:"
  echo "gv:   http://${host}/#s=${token}"
  return 0
}

# Parse args: an optional path to the repo to visualise, --stop, or --seed. (No
# --no-build while developing — we always rebuild from scratch; see the header.)
TARGET=""
SEED=0
LAN=0
for arg in "$@"; do
  case "$arg" in
    --seed) SEED=1 ;;
    --lan) LAN=1 ;;
    --token)
      # Reprint the sign-in link(s) for the already-running server, no rebuild.
      # Print BOTH the loopback/SSH-tunnel link and the LAN-IP link, since which
      # one is right depends on how the server was started (plain vs --lan) and
      # how the device reaches it — the token is the same for either.
      TOKEN="$(tr -d '[:space:]' <"$TOKEN_FILE" 2>/dev/null)" || TOKEN=""
      if [[ -n "$TOKEN" ]]; then
        echo "gv: one-time sign-in link — open it in the browser:"
        echo "gv:   this machine / SSH tunnel:   http://localhost:8080/#s=${TOKEN}"
        LAN_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
        [[ -n "$LAN_IP" ]] && \
          echo "gv:   over the LAN (gv --lan mode):  http://${LAN_IP}:8080/#s=${TOKEN}"
        exit 0
      else
        echo "gv: no bootstrap token found at $TOKEN_FILE" >&2
        echo "gv: is the server running? start it with 'gv' first." >&2
        exit 1
      fi
      ;;
    --stop)
      if pkill -9 -f '[g]it-vista-server' 2>/dev/null; then
        echo "gv: server stopped"
      else
        echo "gv: no server was running"
      fi
      exit 0
      ;;
    -*) echo "gv: unknown option: $arg" >&2; exit 2 ;;
    *)  TARGET="$arg" ;;
  esac
done
TARGET="${TARGET:-$START_DIR}"

# Resolve the target to an absolute path and confirm it's a git repo, so the
# server doesn't just serve an empty graph for a non-repo.
TARGET="$(cd "$TARGET" 2>/dev/null && pwd)" || { echo "gv: no such directory: $TARGET" >&2; exit 1; }
if ! git -C "$TARGET" rev-parse --git-dir >/dev/null 2>&1; then
  echo "gv: '$TARGET' is not a git repository" >&2
  exit 1
fi

# --seed: record this repo's current state as the "Reset Test Repo" point and
# exit (no build, no server). Written where the server looks for it
# (.git/git-vista/): the branch list with tips, the checked-out branch, and a
# bundle of the objects those tips need (so a reset works even after git gc).
if [[ $SEED -eq 1 ]]; then
  GIT_DIR="$(git -C "$TARGET" rev-parse --absolute-git-dir)"
  HEAD_BRANCH="$(git -C "$TARGET" symbolic-ref --short HEAD 2>/dev/null)" || {
    echo "gv: --seed needs a checked-out branch (HEAD is detached)" >&2; exit 1;
  }
  mkdir -p "$GIT_DIR/git-vista"
  git -C "$TARGET" bundle create "$GIT_DIR/git-vista/seed.bundle" --branches 2>/dev/null
  git -C "$TARGET" for-each-ref refs/heads \
    --format='%(objectname) %(refname:short)' > "$GIT_DIR/git-vista/seed-refs"
  printf '%s\n' "$HEAD_BRANCH" > "$GIT_DIR/git-vista/seed-head"
  echo "gv: seed recorded for $TARGET — $(wc -l < "$GIT_DIR/git-vista/seed-refs") branch(es), HEAD ‘$HEAD_BRANCH’"
  echo "gv: the app now offers 'Reset Test Repo' when viewing this repo"
  exit 0
fi

# git-vista repo = the directory this script lives in. `readlink -f` resolves any
# symlinks first (e.g. a `gv` symlink on PATH) back to the real file in the repo.
REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$REPO"

# Avoid the "exit 144 / port 8080 already in use" trap: a stale server from a
# previous run holds the port and the new one gets killed on bind. NOTES:
#   * plain `pkill git-vista-server` matches NOTHING — the process name (comm) is
#     truncated to 15 chars ("git-vista-serve"), so the 16-char pattern misses;
#   * so we match the full command line with `-f`, and use the `[g]...` bracket
#     trick so the pattern doesn't match this script's own command line.
pkill -9 -f '[g]it-vista-server' 2>/dev/null || true

# Always rebuild the wasm SPA from scratch: `trunk clean` wipes dist/ and trunk's
# build cache, then `trunk build` regenerates it. This guarantees the server
# (which serves crates/git-vista/dist/) never hands out a stale frontend bundle —
# the recurring "my new code isn't loading" trap during development.
( cd crates/git-vista && trunk clean && trunk build )

# Build the server in the FOREGROUND so compile errors land in this terminal…
cargo build -p git-vista-server

# …then run the built binary DETACHED: `setsid` gives it its own session with no
# controlling terminal, so a closed terminal / dropped SSH session can't SIGHUP
# it. Its output (including connection guidance) goes to $LOG.
mkdir -p "$LOG_DIR"
echo "=== gv start $(date '+%F %T') — visualising $TARGET" >>"$LOG"
unset GIT_VISTA_BIND_ADDR
if [[ $LAN -eq 1 ]]; then
  export GIT_VISTA_BIND_ADDR="0.0.0.0:8080"
  echo "gv: WARNING: --lan serves git-vista over plain HTTP (no TLS) to your LAN." >&2
  echo "gv: A session is still required, but DNS-rebinding protection is weaker" >&2
  echo "gv: than loopback. Prefer the default SSH-tunnel mode." >&2
fi
setsid "$REPO/target/debug/git-vista-server" "$TARGET" >>"$LOG" 2>&1 </dev/null &

# Don't claim success until it actually serves: catches an immediate crash or a
# port clash, with the log's last lines as the explanation. Probe /api/protocol —
# the one endpoint exempt from the M1.02 protocol-header requirement (every other
# /api/* now answers 426 without an `X-Git-Vista-Protocol` header, which `curl -f`
# would read as "down"). It's also the natural health check: it needs no repo read
# and returns 200 the moment the server is serving.
echo "gv: visualising $TARGET"
for _ in $(seq 1 40); do
  if curl -sf -m 1 "http://localhost:8080/api/protocol" >/dev/null 2>&1; then
    if [[ $LAN -eq 1 ]]; then
      LAN_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
      echo "gv: server up in LAN mode — http://${LAN_IP:-<this-machine-LAN-IP>}:8080/"
      print_setup_url "${LAN_IP:-<this-machine-LAN-IP>}:8080" || \
        echo "gv: (couldn't read the sign-in token yet — try 'gv --token')" >&2
    else
      echo "gv: server up — http://127.0.0.1:8080/"
      echo "gv: 127.0.0.1 works only on this Linux host"
      echo "gv: iPad via SSH: forward local port 8080 to 127.0.0.1:8080"
      echo "gv: iPad via trusted Wi-Fi without SSH: restart with gv --lan"
      print_setup_url "localhost:8080" || \
        echo "gv: (couldn't read the sign-in token yet — try 'gv --token')" >&2
    fi
    echo "gv: log: $LOG    stop: gv --stop    sign-in link: gv --token"
    exit 0
  fi
  sleep 0.25
done
echo "gv: server didn't come up within 10s — last log lines:" >&2
tail -n 20 "$LOG" >&2
exit 1
