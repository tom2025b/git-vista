#!/usr/bin/env bash
# gv — build the Git-Vista frontend and start the server for a Git repository.
#
# Git-Vista serves only IPv4 loopback. An iPad reaches that listener through an
# SSH local-port forward; direct LAN serving is deliberately unsupported because
# it would expose a plain-HTTP Git control surface beyond this machine.
#
#   gv                  visualise the current directory's repository
#   gv ~/code/myproj    visualise another repository
#   gv doctor           diagnose listener/session/tunnel state without secrets
#   gv --token          print a fresh one-time localhost sign-in link
#   gv --stop           stop the server owned by this checkout
#   gv --repo <path|url>  add a repo to the catalog (clones if given a URL),
#                       edits GIT_VISTA_REPOS in the systemd unit, restarts
#                       the service. Restart briefly drops the iPad tunnel.
#   gv --seed [path]    record a TEST repository reset point
#   gv --root <dir>     also serve every repo directly under <dir> (the in-app
#                       picker lists them; e.g. --root ~/projects)
#   gv --lan-view [path]  also bind a second, read-only LAN listener (ADR
#                       0005): a backup path to the iPad when the SSH tunnel
#                       is unavailable. Auto-detects the LAN IP when the
#                       machine has exactly one candidate; otherwise pass
#                       --lan-ip. Plain HTTP — trusted home LAN only, never a
#                       guest/shared network.
#   gv --lan-ip <addr>  the explicit LAN IP for --lan-view, when auto-detect
#                       can't pick a single candidate.
#
# A setup token lives only in a URL fragment (`#s=...`), is single-use, and is
# exchanged for an HttpOnly session cookie. Run `gv --token` again for each new
# browser/device. Never paste the token as a password or reuse one link twice.
set -euo pipefail

PORT=8080
START_DIR="$PWD"
REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SERVER_BIN="$REPO/target/debug/git-vista-server"

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/git-vista"
LOG="$LOG_DIR/server.log"
TOKEN_FILE="$LOG_DIR/bootstrap.token"
PID_FILE="$LOG_DIR/server.pid"
MODE_FILE="$LOG_DIR/server.mode"
TARGET_FILE="$LOG_DIR/server.target"
LAN_FILE="$LOG_DIR/server.lan"

server_health() {
  local host="${1:-localhost}"
  curl -sf -m 2 "http://${host}:${PORT}/api/protocol" >/dev/null 2>&1
}

# Every socket currently listening on $PORT, one per line — plural because
# --lan-view can put two sockets (loopback + the sanctioned LAN ip) on the
# same port; doctor's "bind:" line and listener_mode() below both need every
# one, not just the first `ss` happens to report.
listener_addresses() {
  if command -v ss >/dev/null 2>&1; then
    ss -H -ltn "sport = :${PORT}" 2>/dev/null | awk '{print $4}' | sort -u
  fi
}

listener_pid() {
  if command -v ss >/dev/null 2>&1; then
    ss -H -ltnp "sport = :${PORT}" 2>/dev/null \
      | sed -nE 's/.*pid=([0-9]+).*/\1/p' \
      | head -n 1
  fi
}

# Classify what's actually listening on $PORT against what's sanctioned:
# loopback alone (no --lan-view), or loopback plus the one LAN ip recorded in
# $LAN_FILE at launch (--lan-view). Anything else present -- an extra
# interface, a missing loopback, or a LAN ip that doesn't match what was
# recorded -- is `exposed`, the same SECURITY ERROR classification as before
# this feature landed.
listener_mode() {
  local addresses expected_lan address unexpected=0 saw_loopback=0 saw_lan=0
  addresses="$(listener_addresses)"
  if [[ -z $addresses ]]; then
    if server_health localhost; then
      printf '%s\n' unknown
    else
      printf '%s\n' down
    fi
    return
  fi
  expected_lan=""
  if [[ -r "$LAN_FILE" ]]; then
    expected_lan="$(cat "$LAN_FILE"):${PORT}"
  fi
  while IFS= read -r address; do
    if [[ $address == "127.0.0.1:${PORT}" ]]; then
      saw_loopback=1
    elif [[ -n $expected_lan && $address == "$expected_lan" ]]; then
      saw_lan=1
    else
      unexpected=1
    fi
  done <<<"$addresses"
  if [[ $unexpected -eq 1 || $saw_loopback -eq 0 ]]; then
    printf '%s\n' exposed
  elif [[ -n $expected_lan && $saw_lan -eq 0 ]]; then
    # --lan-view was requested but the sanctioned socket isn't actually up --
    # a mismatch worth flagging, not a silent downgrade to "just loopback".
    printf '%s\n' exposed
  elif [[ -n $expected_lan ]]; then
    printf '%s\n' lan_view
  else
    printf '%s\n' loopback
  fi
}

token_file_is_stale() {
  local modified now
  modified="$(stat -c '%Y' "$TOKEN_FILE" 2>/dev/null)" || return 1
  now="$(date +%s)"
  (( now - modified >= 60 * 60 ))
}

read_token() {
  local token
  token="$(tr -d '[:space:]' <"$TOKEN_FILE" 2>/dev/null)" || return 1
  [[ $token =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$token"
}

print_setup_url() {
  local host="${1:-localhost:${PORT}}" token
  token="$(read_token)" || return 1
  echo "gv: sign in by opening this complete one-time link:"
  echo "gv:   http://${host}/#s=${token}"
  echo "gv: the #s= part is required; it is not a password. Use a fresh link per device."
}

print_token_links() {
  local token mode
  if ! server_health localhost; then
    echo "gv: no Git-Vista server answers on localhost:${PORT}." >&2
    echo "gv: start it with 'gv'." >&2
    return 1
  fi
  if token_file_is_stale; then
    echo "gv: the saved setup token is stale; restart the server to recover." >&2
    return 1
  fi
  token="$(read_token)" || {
    echo "gv: no valid bootstrap token found at $TOKEN_FILE" >&2
    return 1
  }

  mode="$(listener_mode)"
  if [[ $mode == exposed ]]; then
    echo "gv: refusing to print a sign-in token for a non-loopback listener." >&2
    echo "gv: restart it with 'gv' to restore 127.0.0.1:${PORT}." >&2
    return 1
  fi
  echo "gv: one-time sign-in link — open the entire URL:"
  echo "gv:   Linux / SSH tunnel:  http://localhost:${PORT}/#s=${token}"
  if [[ $mode == lan_view && -r "$LAN_FILE" ]]; then
    echo "gv:   LAN view (read-only, this network only):  http://$(cat "$LAN_FILE"):${PORT}/#s=${token}"
  fi
  if [[ $mode == unknown ]]; then
    echo "gv: WARNING: listener address could not be inspected; install 'ss' (iproute2) to verify it." >&2
  fi
  echo "gv: iPad: forward local ${PORT} to Linux 127.0.0.1:${PORT}, then open this localhost link."
  if [[ $mode == lan_view ]]; then
    echo "gv: the LAN view link works directly from any device on this network — no tunnel needed."
    echo "gv: plain HTTP: trusted home LAN only, never a guest or shared network."
  else
    echo "gv: direct 192.168.x.x access is intentionally disabled; use --lan-view to enable a read-only backup."
  fi
  echo "gv: this link is single-use; run 'gv --token' again for the next device."
}

list_lan_ips() {
  if command -v ip >/dev/null 2>&1; then
    ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1
  fi
}

detect_lan_ip() {
  local candidates count
  candidates="$(list_lan_ips)"
  count="$(printf '%s\n' "$candidates" | grep -c .)"
  if [[ $count -eq 1 ]]; then
    printf '%s\n' "$candidates"
    return 0
  fi
  return 1
}

write_private_file() {
  local path="$1" value="$2" temp="${1}.tmp.$$"
  mkdir -p "$(dirname "$path")"
  ( umask 077; printf '%s\n' "$value" >"$temp" )
  mv -f "$temp" "$path"
}

repo_server_pids() {
  local proc pid argv0
  for proc in /proc/[0-9]*; do
    [[ -r "$proc/cmdline" ]] || continue
    pid="${proc##*/}"
    argv0="$(tr '\0' '\n' 2>/dev/null <"$proc/cmdline" | head -n 1)" || continue
    [[ $argv0 == "$SERVER_BIN" ]] && printf '%s\n' "$pid"
  done
  return 0
}

stop_pid() {
  local pid="$1"
  kill "$pid" 2>/dev/null || return 0
  for _ in $(seq 1 30); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.1
  done
  kill -9 "$pid" 2>/dev/null || true
}

stop_repo_servers() {
  local pid found=1
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    stop_pid "$pid"
    found=0
  done < <(repo_server_pids)
  rm -f "$PID_FILE" "$MODE_FILE" "$TARGET_FILE" "$LAN_FILE"
  return "$found"
}

record_runtime_state() {
  local pid="$1" mode="$2" target="$3" lan_ip="${4:-}"
  write_private_file "$PID_FILE" "$pid"
  write_private_file "$MODE_FILE" "$mode"
  write_private_file "$TARGET_FILE" "$target"
  if [[ -n $lan_ip ]]; then
    write_private_file "$LAN_FILE" "$lan_ip"
  else
    rm -f "$LAN_FILE"
  fi
}

doctor() {
  local result=0 addresses mode recorded_mode protocol pid target token_mode modified now age
  echo "Git-Vista doctor (no secrets printed)"
  echo "  checkout: $REPO"
  echo "  Git: $(git --version 2>&1 || echo unavailable)"

  addresses="$(listener_addresses | paste -sd, -)"
  mode="$(listener_mode)"
  echo "  bind: ${addresses:-not detected} (${mode})"
  if [[ $mode == exposed ]]; then
    echo "  SECURITY ERROR: port ${PORT} is reachable on a non-loopback interface."
    result=1
  elif [[ $mode == unknown ]]; then
    echo "  WARNING: listener address could not be verified (the 'ss' command is required)."
    result=1
  fi
  recorded_mode=""
  [[ -r "$MODE_FILE" ]] && recorded_mode="$(cat "$MODE_FILE")"
  if [[ -n "$recorded_mode" && $recorded_mode != "$mode" ]]; then
    echo "  WARNING: recorded launch mode '$recorded_mode' disagrees with live mode '$mode'."
    result=1
  fi
  if server_health localhost; then
    protocol="$(curl -sf -m 2 "http://localhost:${PORT}/api/protocol")"
    echo "  health: healthy — HTTP 200"
    echo "  protocol: $protocol"
  else
    echo "  health: DOWN — no response on localhost:${PORT}"
    result=1
  fi

  pid="$(repo_server_pids | head -n 1)"
  if [[ -n "$pid" ]]; then
    echo "  process: PID $pid (owned by this checkout)"
  else
    pid="$(listener_pid)"
    if [[ -n "$pid" ]]; then
      echo "  process: PID $pid (listener not owned by this checkout)"
    else
      echo "  process: not detected"
    fi
  fi
  target=""
  [[ -r "$TARGET_FILE" ]] && target="$(cat "$TARGET_FILE")"
  if [[ -z "$target" && -n "$pid" && -r "/proc/$pid/cmdline" ]]; then
    target="$(tr '\0' '\n' 2>/dev/null <"/proc/$pid/cmdline" | sed -n '2p')" || target=""
  fi
  echo "  catalog root (launch repository): ${target:-unknown}"
  echo "  catalog root (managed clones): ${TMPDIR:-/tmp}/git-vista-clones"

  if [[ -r "$TOKEN_FILE" ]]; then
    token_mode="$(stat -c '%a' "$TOKEN_FILE" 2>/dev/null || echo unknown)"
    modified="$(stat -c '%Y' "$TOKEN_FILE" 2>/dev/null || echo 0)"
    now="$(date +%s)"
    age=$(( now - modified ))
    if read_token >/dev/null && ! token_file_is_stale; then
      echo "  bootstrap token: present, mode ${token_mode}, age ${age}s (value hidden)"
    else
      echo "  bootstrap token: INVALID OR STALE, mode ${token_mode}, age ${age}s"
      result=1
    fi
    if [[ $token_mode != 600 ]]; then
      echo "  WARNING: bootstrap token permissions should be 600."
      result=1
    fi
  else
    echo "  bootstrap token: missing"
    result=1
  fi

  echo "  tunnel: on the iPad SSH client, forward local ${PORT}"
  echo "          to 127.0.0.1:${PORT} on this Linux host."
  echo "          Then run 'gv --token' and open its localhost link on the iPad."
  if [[ -r "$LAN_FILE" ]]; then
    echo "  LAN view (ADR 0005): $(cat "$LAN_FILE"):${PORT} — read-only, plain HTTP, trusted-LAN only"
  else
    echo "  LAN: direct LAN access is disabled; only the SSH tunnel is supported."
  fi
  return "$result"
}

UNIT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/git-vista.service"
PROJECTS_DIR="$(dirname "$REPO")"

# Add `arg` (a local path or a git@/https:// clone URL) to the systemd unit's
# GIT_VISTA_REPOS list and restart the service so it picks it up. The unit is
# the boot-time registration path (ADR 0009); the alternative, POST
# /api/clone (ADR 0008), needs an authenticated browser session and so isn't
# shell-friendly. Restarting is the tradeoff — GIT_VISTA_REPOS is read once
# at startup, not polled.
repo_add() {
  local arg="$1" repo_path name dest current_line current_val backup new_val new_line tmp
  [[ -f "$UNIT_FILE" ]] || { echo "gv: no unit file at $UNIT_FILE" >&2; return 1; }

  if [[ "$arg" =~ ^(https?://|git@|ssh://) ]]; then
    name="$(basename "$arg" .git)"
    dest="$PROJECTS_DIR/$name"
    if [[ -d "$dest" ]]; then
      echo "gv: $dest already exists, using it"
    else
      echo "gv: cloning $arg -> $dest"
      git clone "$arg" "$dest"
    fi
    repo_path="$dest"
  elif [[ "$arg" == /* || "$arg" == ./* || "$arg" == ../* ]]; then
    repo_path="$(realpath -e "$arg")" || { echo "gv: no such path: $arg" >&2; return 1; }
  else
    # Bare name, no slash — try it as a sibling under ~/projects first (so
    # `gv --repo mcp-fleet` just works), then fall back to CWD-relative.
    if [[ -d "$PROJECTS_DIR/$arg" ]]; then
      repo_path="$(realpath -e "$PROJECTS_DIR/$arg")"
    else
      repo_path="$(realpath -e "$arg")" || {
        echo "gv: no such path: $arg (checked $PROJECTS_DIR/$arg and ./$arg)" >&2
        return 1
      }
    fi
  fi

  [[ -d "$repo_path/.git" || -f "$repo_path/.git" ]] || {
    echo "gv: $repo_path is not a git repo" >&2
    return 1
  }

  current_line="$(grep -m1 '^Environment=GIT_VISTA_REPOS=' "$UNIT_FILE" || true)"
  [[ -n "$current_line" ]] || { echo "gv: no GIT_VISTA_REPOS line in $UNIT_FILE" >&2; return 1; }
  current_val="${current_line#Environment=GIT_VISTA_REPOS=}"

  if [[ ":$current_val:" == *":$repo_path:"* ]]; then
    echo "gv: $repo_path already in GIT_VISTA_REPOS — nothing to do, not restarting"
    return 0
  fi

  backup="$UNIT_FILE.bak-$(date +%Y%m%d-%H%M%S)"
  cp "$UNIT_FILE" "$backup"
  echo "gv: backed up unit to $backup"

  new_val="$current_val:$repo_path"
  new_line="Environment=GIT_VISTA_REPOS=$new_val"
  tmp="$(mktemp)"
  awk -v old="$current_line" -v new="$new_line" \
    '{ if ($0 == old) print new; else print }' "$UNIT_FILE" >"$tmp"
  mv "$tmp" "$UNIT_FILE"
  echo "gv: added $repo_path to GIT_VISTA_REPOS"

  echo "gv: restarting git-vista.service (iPad tunnel will blip)"
  systemctl --user daemon-reload
  systemctl --user restart git-vista.service
  sleep 1
  if systemctl --user is-active --quiet git-vista.service; then
    echo "gv: git-vista.service is active"
  else
    echo "gv: service failed to come back up — check journalctl --user -u git-vista" >&2
    return 1
  fi
}

build_frontend() {
  if [[ ${NO_COLOR+x} ]]; then
    ( cd "$REPO/crates/git-vista" && env -u NO_COLOR trunk build --color never )
  else
    ( cd "$REPO/crates/git-vista" && trunk build )
  fi
}

usage() {
  sed -n '2,/^set -euo pipefail$/p' "${BASH_SOURCE[0]}" \
    | sed '$d; s/^# \{0,1\}//'
}

if [[ ${1:-} == help ]]; then
  usage
  exit 0
fi

if [[ ${1:-} == doctor ]]; then
  [[ $# -eq 1 ]] || { echo "gv: 'doctor' takes no other arguments" >&2; exit 2; }
  doctor
  exit $?
fi

TARGET=""
SEED=0
REPO_ROOT=""
NEXT_IS_ROOT=0
LAN_VIEW=0
LAN_IP=""
NEXT_IS_LAN_IP=0
NEXT_IS_REPO=0
for arg in "$@"; do
  if [[ $NEXT_IS_ROOT -eq 1 ]]; then
    REPO_ROOT="$arg"
    NEXT_IS_ROOT=0
    continue
  fi
  if [[ $NEXT_IS_LAN_IP -eq 1 ]]; then
    LAN_IP="$arg"
    NEXT_IS_LAN_IP=0
    continue
  fi
  if [[ $NEXT_IS_REPO -eq 1 ]]; then
    repo_add "$arg"
    exit $?
  fi
  case "$arg" in
    --repo) NEXT_IS_REPO=1 ;;
    --seed) SEED=1 ;;
    # ADR 0009: one deliberate repos root; the server scans its direct children.
    --root) NEXT_IS_ROOT=1 ;;
    --root=*) REPO_ROOT="${arg#--root=}" ;;
    # ADR 0005: opt-in second, read-only LAN listener.
    --lan-view) LAN_VIEW=1 ;;
    --lan-ip) NEXT_IS_LAN_IP=1 ;;
    --lan-ip=*) LAN_IP="${arg#--lan-ip=}" ;;
    --lan)
      echo "gv: --lan is disabled; Git-Vista only listens on 127.0.0.1:${PORT}." >&2
      echo "gv: use an SSH local-port forward for iPad access, or 'gv --lan-view' for a read-only LAN backup." >&2
      exit 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --doctor)
      doctor
      exit $?
      ;;
    --token)
      print_token_links
      exit $?
      ;;
    --stop)
      if stop_repo_servers; then
        echo "gv: server owned by $REPO stopped"
      elif server_health localhost; then
        echo "gv: a server answers on ${PORT}, but it is not owned by this checkout; refusing to kill it." >&2
        exit 1
      else
        echo "gv: no server owned by this checkout is running"
      fi
      exit 0
      ;;
    -*) echo "gv: unknown option: $arg" >&2; exit 2 ;;
    *) TARGET="$arg" ;;
  esac
done
if [[ $NEXT_IS_ROOT -eq 1 ]]; then
  echo "gv: --root needs a directory" >&2
  exit 2
fi
if [[ $NEXT_IS_REPO -eq 1 ]]; then
  echo "gv: --repo needs a path or URL" >&2
  exit 2
fi
if [[ -n $REPO_ROOT && ! -d $REPO_ROOT ]]; then
  echo "gv: --root: no such directory: $REPO_ROOT" >&2
  exit 2
fi
if [[ $NEXT_IS_LAN_IP -eq 1 ]]; then
  echo "gv: --lan-ip needs an address" >&2
  exit 2
fi
if [[ $LAN_VIEW -eq 1 && -z $LAN_IP ]]; then
  LAN_IP="$(detect_lan_ip)" || {
    echo "gv: --lan-view needs --lan-ip <addr> — couldn't auto-detect a single LAN address" >&2
    echo "gv: candidates found:" >&2
    list_lan_ips >&2
    exit 2
  }
elif [[ $LAN_VIEW -eq 0 && -n $LAN_IP ]]; then
  echo "gv: --lan-ip only applies with --lan-view" >&2
  exit 2
fi
if [[ -n $LAN_IP ]]; then
  case "$LAN_IP" in
    127.*|0.0.0.0)
      echo "gv: --lan-ip must be a real LAN interface address, not loopback or 0.0.0.0" >&2
      exit 2
      ;;
  esac
fi
TARGET="${TARGET:-$START_DIR}"

TARGET="$(cd "$TARGET" 2>/dev/null && pwd)" || {
  echo "gv: no such directory: $TARGET" >&2
  exit 1
}
if ! git -C "$TARGET" rev-parse --git-dir >/dev/null 2>&1; then
  echo "gv: '$TARGET' is not a Git repository" >&2
  exit 1
fi

if [[ $SEED -eq 1 ]]; then
  GIT_DIR="$(git -C "$TARGET" rev-parse --absolute-git-dir)"
  HEAD_BRANCH="$(git -C "$TARGET" symbolic-ref --short HEAD 2>/dev/null)" || {
    echo "gv: --seed needs a checked-out branch (HEAD is detached)" >&2
    exit 1
  }
  mkdir -p "$GIT_DIR/git-vista"
  git -C "$TARGET" bundle create "$GIT_DIR/git-vista/seed.bundle" --branches 2>/dev/null
  git -C "$TARGET" for-each-ref refs/heads \
    --format='%(objectname) %(refname:short)' >"$GIT_DIR/git-vista/seed-refs"
  printf '%s\n' "$HEAD_BRANCH" >"$GIT_DIR/git-vista/seed-head"
  echo "gv: seed recorded for $TARGET — $(wc -l <"$GIT_DIR/git-vista/seed-refs") branch(es), HEAD '$HEAD_BRANCH'"
  echo "gv: the app now offers 'Reset Test Repo' when viewing this repository"
  exit 0
fi

cd "$REPO"

# Build both halves before touching the live process. A failed build leaves the
# last working server intact.
build_frontend
cargo build -p git-vista-server

# Stop only a process whose argv[0] is this checkout's server binary. This safely
# adopts pre-PID-file launcher generations without killing another checkout.
stop_repo_servers || true
if server_health localhost; then
  echo "gv: port ${PORT} is occupied by a server not owned by $REPO; refusing to kill it." >&2
  exit 1
fi

mkdir -p "$LOG_DIR"
echo "=== gv start $(date '+%F %T') — visualising $TARGET" >>"$LOG"
export GIT_VISTA_BIND_ADDR="127.0.0.1:${PORT}"
# ADR 0009: env form so systemd units can set the same root without the flag.
if [[ -n $REPO_ROOT ]]; then
  export GIT_VISTA_REPO_ROOT="$REPO_ROOT"
fi
# ADR 0005: opt-in second, read-only LAN listener.
if [[ $LAN_VIEW -eq 1 ]]; then
  export GIT_VISTA_LAN_IP="$LAN_IP"
fi

setsid "$SERVER_BIN" "$TARGET" >>"$LOG" 2>&1 </dev/null &
SERVER_PID=$!
LAUNCH_MODE=loopback
if [[ $LAN_VIEW -eq 1 ]]; then
  LAUNCH_MODE=lan_view
fi
record_runtime_state "$SERVER_PID" "$LAUNCH_MODE" "$TARGET" "$LAN_IP"

echo "gv: visualising $TARGET"
for _ in $(seq 1 40); do
  if server_health localhost; then
    LIVE_MODE="$(listener_mode)"
    if [[ $LIVE_MODE == exposed ]]; then
      echo "gv: SECURITY ERROR: server opened a non-loopback listener; stopping it." >&2
      stop_pid "$SERVER_PID"
      rm -f "$PID_FILE" "$MODE_FILE" "$TARGET_FILE" "$LAN_FILE"
      exit 1
    fi
    echo "gv: server up in loopback/SSH mode — http://127.0.0.1:${PORT}/"
    echo "gv: iPad SSH forward: local ${PORT} -> Linux 127.0.0.1:${PORT}"
    if [[ -n $LAN_IP ]]; then
      echo "gv: LAN view up — http://${LAN_IP}:${PORT}/ (read-only, plain HTTP, trusted LAN only)"
    fi
    print_setup_url "localhost:${PORT}" || \
      echo "gv: couldn't read the sign-in token yet; try 'gv --token'" >&2
    echo "gv: log: $LOG    diagnose: gv doctor    stop: gv --stop"
    exit 0
  fi
  kill -0 "$SERVER_PID" 2>/dev/null || break
  sleep 0.25
done

echo "gv: server did not come up — last log lines:" >&2
tail -n 20 "$LOG" >&2
stop_pid "$SERVER_PID"
rm -f "$PID_FILE" "$MODE_FILE" "$TARGET_FILE" "$LAN_FILE"
exit 1
